<!-- POST MODAL -->
<div class="modal-bg" id="postModalBg">
  <div class="modal">
    <div class="modal-head">
      <div class="modal-title">Post a Casting Call</div>
      <button class="modal-close" onclick="closePostModal()">×</button>
    </div>
    <div class="modal-body">
      <div class="form-group">
        <label class="form-label">Production / Company Name</label>
        <input class="form-input" id="postCompany" placeholder="e.g. Astro Shaw, F12 Records, Independent">
      </div>
      <div class="form-group">
        <label class="form-label">Role Title</label>
        <input class="form-input" id="postTitle" placeholder="e.g. Lead Actor — Drama Series">
      </div>
      <div class="form-row">
        <div>
          <label class="form-label">Role Type</label>
          <select class="form-select" id="postType">
            <option>Lead Role</option>
            <option>Supporting Role</option>
            <option>Featured Extra</option>
            <option>Music Video Actor</option>
            <option>Commercial</option>
            <option>Short Film</option>
            <option>Director</option>
            <option>Voice Actor</option>
          </select>
        </div>
        <div>
          <label class="form-label">Location</label>
          <select class="form-select" id="postLocation">
            <option>Kuala Lumpur, MY</option>
            <option>Penang, MY</option>
            <option>Johor Bahru, MY</option>
            <option>Jakarta, ID</option>
            <option>Bali, ID</option>
            <option>Manila, PH</option>
            <option>Bangkok, TH</option>
            <option>Singapore, SG</option>
            <option>Ho Chi Minh City, VN</option>
            <option>Remote / Online</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Description</label>
        <textarea class="form-textarea" id="postDesc" placeholder="Describe the role, project, character background, requirements…"></textarea>
      </div>
      <div class="form-row">
        <div>
          <label class="form-label">Gender</label>
          <select class="form-select" id="postGender">
            <option>Any</option><option>Male</option><option>Female</option><option>Non-binary</option>
          </select>
        </div>
        <div>
          <label class="form-label">Age Range</label>
          <input class="form-input" id="postAge" placeholder="e.g. 20–35">
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Payment</label>
        <div class="pay-options">
          <div class="pay-opt sel" onclick="selectPay(this)">💰 Paid</div>
          <div class="pay-opt" onclick="selectPay(this)">🤝 Revenue Share</div>
          <div class="pay-opt" onclick="selectPay(this)">🎬 Credit Only</div>
          <div class="pay-opt" onclick="selectPay(this)">🔒 Confidential</div>
        </div>
      </div>
      <div class="form-row">
        <div>
          <label class="form-label">Deadline</label>
          <input class="form-input" type="date" id="postDeadline">
        </div>
        <div>
          <label class="form-label">Contact / Apply Via</label>
          <input class="form-input" id="postContact" placeholder="email or Instagram">
        </div>
      </div>
      <button class="submit-btn" id="postSubmitBtn" onclick="submitPost()">Post Casting Call 🎬</button>
    </div>
  </div>
</div>

<!-- APPLY MODAL -->
<div class="modal-bg" id="applyModalBg">
  <div class="apply-modal">
    <div class="apply-head">
      <div>
        <div class="apply-title" id="applyRoleTitle">Apply for Role</div>
        <div class="apply-sub" id="applyCompany">Company</div>
      </div>
      <button class="modal-close" onclick="closeApplyModal()">×</button>
    </div>
    <div class="apply-body">
      <div class="form-group">
        <label class="form-label">Your Name</label>
        <input class="form-input" id="applyName" placeholder="Full name">
      </div>
      <div class="form-group">
        <label class="form-label">Instagram / Portfolio Link</label>
        <input class="form-input" id="applyPortfolio" placeholder="@yourhandle or website link">
      </div>
      <div class="form-group">
        <label class="form-label">Why are you right for this role?</label>
        <textarea class="form-textarea" id="applyMsg" placeholder="Brief pitch — keep it sharp and honest." style="height:80px"></textarea>
      </div>
      <div class="form-group">
        <label class="form-label">Experience</label>
        <select class="form-select" id="applyExp">
          <option>New — this would be my first credit</option>
          <option>1–3 years experience</option>
          <option>3–5 years experience</option>
          <option>5+ years, professional</option>
        </select>
      </div>
      <button class="submit-btn" onclick="submitApply()" style="margin-top:4px">Submit Application 🎭</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>

// ── Data ──
const AVATAR_COLORS=[
  'linear-gradient(135deg,#e8173a,#ff8fa3)',
  'linear-gradient(135deg,#1a56db,#60a5fa)',
  'linear-gradient(135deg,#7c3aed,#c4b5fd)',
  'linear-gradient(135deg,#c9a84c,#fde68a)',
  'linear-gradient(135deg,#059669,#6ee7b7)',
  'linear-gradient(135deg,#dc2626,#fca5a5)',
  'linear-gradient(135deg,#0891b2,#67e8f9)',
  'linear-gradient(135deg,#d97706,#fcd34d)',
];

function ac(str){let h=0;for(let c of str)h=c.charCodeAt(0)+((h<<5)-h);return AVATAR_COLORS[Math.abs(h)%AVATAR_COLORS.length];}

const castings=[
  {
    id:1,company:'Astro Shaw',logo:'AS',logoColor:'linear-gradient(135deg,#e8173a,#c9102f)',
    title:'Lead Actor — Malay Drama Series (TV3)',
    desc:'Seeking a compelling male lead for an 8-episode family drama series. Character is a young architect navigating career ambition and family duty in modern KL. Must be comfortable with emotional range and naturalistic performance.',
    type:'Lead Role',location:'Kuala Lumpur, MY',gender:'Male',age:'25–38',
    pay:'Paid',deadline:'May 15, 2026',contact:'casting@astroshaw.com',
    tags:['actor','lead','drama','malay','kl'],
    badge:'urgent',badgeLabel:'URGENT',
    applicants:23,time:'2h ago',saved:false,applied:false
  },
  {
    id:2,company:'F12 Records',logo:'F12',logoColor:'linear-gradient(135deg,#0a0a0a,#333)',
    title:'Actor — Music Video (Rap / Urban)',
    desc:'F12 Records is casting for a lead actor in an upcoming music video production. Looking for someone with strong screen presence and comfort in urban/street aesthetic. Acting experience preferred but not required — personality is key.',
    type:'Music Video Actor',location:'Kuala Lumpur, MY',gender:'Any',age:'18–30',
    pay:'Paid',deadline:'May 8, 2026',contact:'@f12records',
    tags:['music video','urban','rapper','kl','f12'],
    badge:'featured',badgeLabel:'FEATURED',
    applicants:41,time:'4h ago',saved:false,applied:false
  },
  {
    id:3,company:'HBO Asia',logo:'HBO',logoColor:'linear-gradient(135deg,#1a1a2e,#16213e)',
    title:'Supporting Actor — Psychological Thriller',
    desc:'Casting supporting roles for a 6-episode HBO Asia psychological thriller series filming in KL and Penang. Seeking actors comfortable with morally complex characters. Previous TV experience required.',
    type:'Supporting Role',location:'Kuala Lumpur, MY',gender:'Any',age:'30–50',
    pay:'Confidential',deadline:'May 20, 2026',contact:'casting@hboasia.com',
    tags:['hbo','thriller','supporting','tv','series'],
    badge:'open',badgeLabel:'OPEN',
    applicants:67,time:'6h ago',saved:false,applied:false
  },
  {
    id:4,company:'GadisFilem',logo:'GF',logoColor:'linear-gradient(135deg,#c9a84c,#f59e0b)',
    title:'Female Lead — Indie Short Film',
    desc:'Independent short film exploring the lives of three women in contemporary KL. Looking for a strong female lead aged 22–32. Will be submitted to MIFFest 2026. Revenue share available.',
    type:'Lead Role',location:'Kuala Lumpur, MY',gender:'Female',age:'22–32',
    pay:'Revenue Share',deadline:'May 12, 2026',contact:'gadisfilem@gmail.com',
    tags:['indie','short film','female lead','miffest'],
    badge:'open',badgeLabel:'OPEN',
    applicants:18,time:'1d ago',saved:false,applied:false
  },
  {
    id:5,company:'TikTok SEA',logo:'TT',logoColor:'linear-gradient(135deg,#010101,#333)',
    title:'Content Creator / Actor — Brand Campaign',
    desc:'TikTok SEA is looking for authentic actors and content creators across Southeast Asia for a regional brand campaign. Must have existing social presence. Filming across KL, Jakarta and Manila.',
    type:'Commercial',location:'Remote / Online',gender:'Any',age:'18–28',
    pay:'Paid',deadline:'May 30, 2026',contact:'creators@tiktok.com',
    tags:['tiktok','commercial','brand','sea','creator'],
    badge:'open',badgeLabel:'OPEN',
    applicants:134,time:'2d ago',saved:false,applied:false
  },
  {
    id:6,company:'Primeworks Studios',logo:'PS',logoColor:'linear-gradient(135deg,#0066ff,#3b82f6)',
    title:'Director — Raya Special (TV)',
    desc:'Seeking an experienced director for a 90-minute Hari Raya TV special airing on Media Prima. Must have minimum 3 years directing experience for broadcast. Budget and treatment discussion upon shortlist.',
    type:'Director',location:'Kuala Lumpur, MY',gender:'Any',age:'Any',
    pay:'Paid',deadline:'May 5, 2026',contact:'primeworks.casting@mediaprimastudios.com',
    tags:['director','raya','tv','media prima','broadcast'],
    badge:'urgent',badgeLabel:'URGENT',
    applicants:12,time:'3d ago',saved:false,applied:false
  },
];

const talents=[
  {id:1,name:'Amirah Zahra',role:'Actress · Director',location:'KL, MY',tags:['drama','film','commercial'],credits:['Astro Originals','MIFFest 2025'],exp:'6 years'},
  {id:2,name:'Danial Hakim',role:'Actor · Model',location:'Penang, MY',tags:['lead','action','drama'],credits:['TV3 Drama','Celcom Campaign'],exp:'4 years'},
  {id:3,name:'Priya Nair',role:'Actress · Voice Actor',location:'KL, MY',tags:['voice','drama','comedy'],credits:['HBO Asia','Radio Drama'],exp:'8 years'},
  {id:4,name:'Reza Adriansyah',role:'Actor · Screenwriter',location:'Jakarta, ID',tags:['drama','indie','writing'],credits:['Netflix ID','Sundance Short'],exp:'5 years'},
  {id:5,name:'Sofia Bautista',role:'Actress · Dancer',location:'Manila, PH',tags:['musical','drama','dance'],credits:['ABS-CBN','GMA Network'],exp:'7 years'},
  {id:6,name:'Ahmad Fadzil',role:'Director · Producer',location:'KL, MY',tags:['director','film','tv'],credits:['Primeworks','KL48h Film Fest'],exp:'10 years'},
  {id:7,name:'Nadia Rahmat',role:'Actress · MC',location:'KL, MY',tags:['hosting','drama','commercial'],credits:['Media Prima','Maxis Campaign'],exp:'3 years'},
  {id:8,name:'Tariq Ismail',role:'Actor · Stuntman',location:'KL, MY',tags:['action','stunt','drama'],credits:['J Revolusi','Paskal'],exp:'9 years'},
];

let currentApplyId=null;
let currentFilter='all';
let currentPaySel=0;

// ── Init ──
window.onload=()=>{
  renderCasting(castings);
  renderTalent(talents);
  renderNetwork();
  renderFeaturedTalent();
};

// ── Casting ──
function renderCasting(list){
  const feed=document.getElementById('castingFeed');
  feed.innerHTML='';
  document.getElementById('castingCount').textContent=`${list.length} open roles`;
  document.getElementById('statRoles').textContent=list.length;
  document.getElementById('heroRoles').textContent=list.length;
  list.forEach(c=>feed.appendChild(buildCastingCard(c)));
}

function buildCastingCard(c){
  const div=document.createElement('div');
  div.className='casting-card';div.id=`casting-${c.id}`;

  const barClass=c.badge==='featured'?'gold':c.badge==='urgent'?'urgent':'';
  const badgeClass=c.badge==='urgent'?'badge-urgent':c.badge==='featured'?'badge-featured':c.badge==='open'?'badge-open':'badge-closed';

  const applicantAvatars=Array.from({length:Math.min(3,c.applicants)},(_,i)=>{
    const colors=['#e8173a','#1a56db','#059669'];
    return `<div class="applicant-av" style="background:${colors[i]}">${String.fromCharCode(65+i)}</div>`;
  }).join('');

  div.innerHTML=`
    <div class="card-accent-bar ${barClass}"></div>
    <div class="card-inner">
      <div class="card-top-row">
        <div class="card-company">
          <div class="company-logo" style="background:${c.logoColor}">${c.logo}</div>
          <div class="company-info">
            <div class="company-name">${escHtml(c.company)}<span class="verified-badge">✓</span></div>
            <div class="post-time">${c.time}</div>
          </div>
        </div>
        <span class="card-badge ${badgeClass}">${c.badgeLabel}</span>
      </div>
      <div class="card-title">${escHtml(c.title)}</div>
      <div class="card-desc">${escHtml(c.desc)}</div>
      <div class="card-tags">
        <span class="tag red">${c.type}</span>
        <span class="tag">${c.gender}</span>
        <span class="tag">${c.age}</span>
        <span class="tag gold">${c.pay}</span>
        ${c.tags.slice(0,3).map(t=>`<span class="tag">#${t}</span>`).join('')}
      </div>
      <div class="card-details">
        <div class="detail-item">
          <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          ${escHtml(c.location)}
        </div>
        <div class="detail-item">
          <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          Deadline: ${c.deadline}
        </div>
        <div class="detail-item">
          <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          ${c.applicants} applied
        </div>
      </div>
      <div class="card-footer">
        <div class="footer-left">
          <div class="applicant-avatars">${applicantAvatars}</div>
          <span class="applicant-count">+${c.applicants} applicants</span>
        </div>
        <div class="footer-right">
          <button class="save-btn ${c.saved?'saved':''}" id="save-${c.id}" onclick="toggleSave(${c.id})">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="${c.saved?'currentColor':'none'}" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
            ${c.saved?'Saved':'Save'}
          </button>
          <button class="apply-btn ${c.applied?'applied':''}" id="apply-${c.id}" onclick="openApplyModal(${c.id})" ${c.applied?'disabled':''}>
            ${c.applied?'✓ Applied':'Apply Now'}
          </button>
        </div>
      </div>
    </div>`;
  return div;
}

function filterCasting(type,btn){
  document.querySelectorAll('#tab-casting .filter-chip').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  currentFilter=type;
  if(type==='all'){renderCasting(castings);return;}
  if(type==='featured'){renderCasting(castings.filter(c=>c.badge==='featured'));return;}
  renderCasting(castings.filter(c=>
    c.type.toLowerCase().includes(type)||
    c.tags.some(t=>t.includes(type))
  ));
}

function toggleSave(id){
  const c=castings.find(x=>x.id===id);if(!c)return;
  c.saved=!c.saved;
  const btn=document.getElementById(`save-${id}`);
  btn.classList.toggle('saved',c.saved);
  btn.innerHTML=`<svg width="13" height="13" viewBox="0 0 24 24" fill="${c.saved?'currentColor':'none'}" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>${c.saved?'Saved':'Save'}`;
  showToast(c.saved?'Saved to your list ✓':'Removed from saved');
}

// ── Apply ──
function openApplyModal(id){
  const c=castings.find(x=>x.id===id);if(!c)return;
  currentApplyId=id;
  document.getElementById('applyRoleTitle').textContent=c.title;
  document.getElementById('applyCompany').textContent=c.company+' · '+c.location;
  document.getElementById('applyModalBg').classList.add('open');
  document.body.style.overflow='hidden';
}

function closeApplyModal(){
  document.getElementById('applyModalBg').classList.remove('open');
  document.body.style.overflow='';
}

function submitApply(){
  const name=document.getElementById('applyName').value.trim();
  const msg=document.getElementById('applyMsg').value.trim();
  if(!name){showToast('Enter your name');return;}
  if(!msg){showToast('Write your pitch');return;}
  const c=castings.find(x=>x.id===currentApplyId);
  if(c){c.applied=true;c.applicants++;
    const btn=document.getElementById(`apply-${currentApplyId}`);
    if(btn){btn.textContent='✓ Applied';btn.classList.add('applied');btn.disabled=true;}
    const countEls=document.querySelectorAll(`#casting-${currentApplyId} .applicant-count`);
    countEls.forEach(el=>el.textContent=`+${c.applicants} applicants`);
  }
  document.getElementById('applyName').value='';
  document.getElementById('applyMsg').value='';
  closeApplyModal();
  showToast('Application submitted! 🎭 Good luck.');
}

// ── Talent ──
function renderTalent(list){
  const feed=document.getElementById('talentFeed');
  feed.innerHTML='';
  list.forEach(t=>feed.appendChild(buildTalentCard(t)));
}

function buildTalentCard(t){
  const div=document.createElement('div');
  div.className='profile-card';
  const initials=t.name.split(' ').map(n=>n[0]).join('').slice(0,2).toUpperCase();
  div.innerHTML=`
    <div class="profile-pic" style="background:${ac(t.name)}">${initials}</div>
    <div class="profile-info">
      <div class="profile-name">${escHtml(t.name)}</div>
      <div class="profile-role">${escHtml(t.role)} · ${escHtml(t.location)} · ${t.exp}</div>
      <div class="profile-tags">
        ${t.tags.map(tag=>`<span class="profile-tag">${tag}</span>`).join('')}
        ${t.credits.map(c=>`<span class="profile-tag" style="background:var(--accent-light);color:var(--accent)">${c}</span>`).join('')}
      </div>
    </div>
    <button class="connect-btn" onclick="toggleConnect(this)">Connect</button>`;
  return div;
}

function filterTalent(type,btn){
  document.querySelectorAll('#tab-talent .filter-chip').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  if(type==='all'){renderTalent(talents);return;}
  renderTalent(talents.filter(t=>t.role.toLowerCase().includes(type)||t.tags.some(tag=>tag.includes(type))));
}

function toggleConnect(btn){
  const connected=btn.classList.toggle('connected');
  btn.textContent=connected?'✓ Connected':'Connect';
  showToast(connected?'Connected! 🤝':'Removed connection');
}

// ── Network ──
function renderNetwork(){
  const feed=document.getElementById('networkFeed');
  feed.innerHTML='';
  const networked=[...talents].sort(()=>Math.random()-0.5).slice(0,6);
  networked.forEach(t=>{
    const div=document.createElement('div');
    div.className='profile-card';
    const initials=t.name.split(' ').map(n=>n[0]).join('').slice(0,2).toUpperCase();
    const reason=['Works in KL','Director in your field','3 mutual connections','Active this week','Similar credits'][Math.floor(Math.random()*5)];
    div.innerHTML=`
      <div class="profile-pic" style="background:${ac(t.name)}">${initials}</div>
      <div class="profile-info">
        <div class="profile-name">${escHtml(t.name)}</div>
        <div class="profile-role">${escHtml(t.role)} · ${reason}</div>
        <div class="profile-tags">${t.tags.map(tag=>`<span class="profile-tag">${tag}</span>`).join('')}</div>
      </div>
      <button class="connect-btn" onclick="toggleConnect(this)">Connect</button>`;
    feed.appendChild(div);
  });
}

// ── Featured sidebar ──
function renderFeaturedTalent(){
  const container=document.getElementById('featuredTalent');
  talents.slice(0,4).forEach(t=>{
    const initials=t.name.split(' ').map(n=>n[0]).join('').slice(0,2).toUpperCase();
    const div=document.createElement('div');
    div.className='featured-profile';
    div.innerHTML=`
      <div class="fp-pic" style="background:${ac(t.name)}">${initials}</div>
      <div class="fp-info">
        <div class="fp-name">${escHtml(t.name)}</div>
        <div class="fp-role">${escHtml(t.role)}</div>
      </div>
      <button class="fp-connect" onclick="toggleConnect(this)">+</button>`;
    container.appendChild(div);
  });
}

// ── Post ──
function openPostModal(){document.getElementById('postModalBg').classList.add('open');document.body.style.overflow='hidden';}
function closePostModal(){document.getElementById('postModalBg').classList.remove('open');document.body.style.overflow='';}

function selectPay(el){
  document.querySelectorAll('.pay-opt').forEach(o=>o.classList.remove('sel'));
  el.classList.add('sel');
}

function submitPost(){
  const company=document.getElementById('postCompany').value.trim();
  const title=document.getElementById('postTitle').value.trim();
  const desc=document.getElementById('postDesc').value.trim();
  if(!company){showToast('Enter company name');return;}
  if(!title){showToast('Enter role title');return;}
  if(!desc){showToast('Add a description');return;}

  const payEl=document.querySelector('.pay-opt.sel');
  const newCasting={
    id:Date.now(),company,
    logo:company.slice(0,2).toUpperCase(),
    logoColor:ac(company),
    title,desc,
    type:document.getElementById('postType').value,
    location:document.getElementById('postLocation').value,
    gender:document.getElementById('postGender').value,
    age:document.getElementById('postAge').value||'Open',
    pay:payEl?payEl.textContent.replace(/[💰🤝🎬🔒]/g,'').trim():'Paid',
    deadline:document.getElementById('postDeadline').value||'Open',
    contact:document.getElementById('postContact').value||'See post',
    tags:[document.getElementById('postType').value.toLowerCase()],
    badge:'open',badgeLabel:'OPEN',
    applicants:0,time:'just now',saved:false,applied:false
  };

  castings.unshift(newCasting);
  closePostModal();
  switchTab('casting',document.querySelector('.nav-tab'));
  renderCasting(castings);

  // Reset
  ['postCompany','postTitle','postDesc','postAge','postDeadline','postContact'].forEach(id=>{
    document.getElementById(id).value='';
  });
  showToast('Casting call posted! 🎬');
}

// ── Tabs ──
function switchTab(tab,btn){
  document.querySelectorAll('.tab-content').forEach(t=>t.classList.remove('active'));
  document.querySelectorAll('.nav-tab').forEach(b=>b.classList.remove('active'));
  document.getElementById(`tab-${tab}`).classList.add('active');
  if(btn)btn.classList.add('active');
}

// ── Helpers ──
function escHtml(str){
  return String(str).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
}

function showToast(msg){
  const t=document.getElementById('toast');
  t.textContent=msg;t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'),2500);
}

document.getElementById('postModalBg').addEventListener('click',function(e){if(e.target===this)closePostModal();});
document.getElementById('applyModalBg').addEventListener('click',function(e){if(e.target===this)closeApplyModal();});
</script>
</body>
</html>
